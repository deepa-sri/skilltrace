# Copy to .env and adjust
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# XAMPP MySQL / MariaDB (default XAMPP root has empty password)
DB_ENGINE=mysql
DB_NAME=skilltrace
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Use this instead for a quick run without MySQL
# DB_ENGINE=sqlite

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Optional. Without a key every AI feature falls back to rule-based logic.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
